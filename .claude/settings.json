{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "teammateMode": "tmux",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PERSON_DB_URL": "postgres:postgres@localhost:5432/persondb",
    "comment": "reading from here doesn't work"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-blackbox-log.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-audit-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/save-plan.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(ls:*)",
      "Bash(jar tf:*)",
      "Bash(java:*)",
      "Bash(curl -s https://repo1.maven.org/maven2/org/springframework/boot/spring-boot-starter-parent/maven-metadata.xml)",
      "Bash(grep -E \"\\\\.java$|\\\\.yml$|\\\\.properties$|src/\")",
      "Bash(git ls-tree:*)",
      "Bash(grep -E \"\\\\.\\(java|yml|properties|xml\\)$\")",
      "Bash(docker compose up:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose down:*)",
      "Bash(find . -type f \\\\\\(-name *.java -o -name *.xml -o -name *.yaml -o -name *.yml \\\\\\))",
      "Bash(git add *)",
      "mcp__postgres-persons__query"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "postgres-persons"
  ],
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\u001b[36m\\(.model.display_name) [effort: \\(.effort.level) | think: \\(.thinking.enabled)]\\u001b[0m | context: \\u001b[33m\\(.context_window.used_percentage // 0)%\\u001b[0m | limit: \\u001b[32m\\(.rate_limits.five_hour.used_percentage)% [\\(.rate_limits.five_hour.resets_at | strflocaltime(\"%H:%M\"))]\\u001b[0m\"'"
  }
}
